# =============================================
# SUPABASE DATABASE CONFIGURATION (Connection Pooling / IPv4)
# =============================================
# Catatan penting:
# Host direct (db.xxxx.supabase.co) di Supabase hanya menggunakan IPv6.
# Jika ISP/Windows Anda tidak support IPv6, gunakan Supabase Connection Pooler (IPv4).
#
# Format:
# DB_HOST     : aws-0-[region].pooler.supabase.com (contoh region Sydney: aws-0-ap-southeast-2.pooler.supabase.com)
# DB_PORT     : 5432 (Session mode) atau 6543 (Transaction mode)
# DB_NAME     : postgres
# DB_USER     : postgres.[PROJECT_REF]
# DB_PASSWORD : [PASSWORD_DATABASE_ANDA]
# =============================================

DB_HOST=aws-0-ap-southeast-2.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.kvfrlriskmcdtktfmfta
DB_PASSWORD=YOUR_PASSWORD_HERE
